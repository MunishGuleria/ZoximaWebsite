# --- Contact form (app/api/contact/route.ts) ---------------------------------
# Email is sent through Azure Communication Services (ACS) Email.
# Copy this file to .env for local development; set the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Required. Azure portal → your Communication Services resource →
# Settings → Keys → Connection string (Primary key). Looks like
# endpoint=https://<name>.<region>.communication.azure.com/;accesskey=<key>
AZURE_COMMUNICATION_CONNECTION_STRING=

# Required. Sender address on a domain connected to the resource above.
# Azure portal → your Email Communication Service → Provision domains →
# <domain> → MailFrom addresses, e.g. DoNotReply@zoxima.com (or the
# DoNotReply@<guid>.azurecomm.net address of the Azure managed domain).
CONTACT_FROM_EMAIL=

# Where enquiries are delivered. Comma-separated list allowed, e.g.
# info@zoxima.com,munish.kumar@zoxima.com. Defaults to info@zoxima.com.
# Nothing is sent to the visitor.
CONTACT_TO_EMAIL=

# --- Salesforce guide form (app/api/guide/route.ts) --------------------------
# Uses the same AZURE_COMMUNICATION_CONNECTION_STRING, CONTACT_FROM_EMAIL and
# CONTACT_TO_EMAIL as the contact form (the new-lead alert goes to
# CONTACT_TO_EMAIL, from CONTACT_FROM_EMAIL). Nothing else to set.
