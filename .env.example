# --- Contact form (app/api/contact/route.ts) ---------------------------------
# Email is sent through Azure Communication Services (ACS) Email.
# Copy this file to .env for local development; set the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Required. Azure portal → your Communication Services resource →
# Settings → Keys → Connection string (Primary key). Looks like
# endpoint=https://<name>.<region>.communication.azure.com/;accesskey=<key>
AZURE_COMMUNICATION_CONNECTION_STRING=

# Required. Sender address on a domain connected to the resource above.
# Azure portal → your Email Communication Service → Provision domains →
# <domain> → MailFrom addresses, e.g. DoNotReply@zoxima.com (or the
# DoNotReply@<guid>.azurecomm.net address of the Azure managed domain).
CONTACT_FROM_EMAIL=

# Where enquiries are delivered. Comma-separated list allowed, e.g.
# info@zoxima.com,munish.kumar@zoxima.com. Defaults to info@zoxima.com.
# Nothing is sent to the visitor.
CONTACT_TO_EMAIL=

# --- Salesforce guide form (app/api/guide/route.ts) --------------------------
# Uses the same AZURE_COMMUNICATION_CONNECTION_STRING, CONTACT_FROM_EMAIL and
# CONTACT_TO_EMAIL as the contact form (the new-lead alert goes to
# CONTACT_TO_EMAIL, from CONTACT_FROM_EMAIL). These three are optional.

# Optional. Sender of the guide email the visitor receives, e.g.
# guide@zoxima.com. Must be a MailFrom address on a domain connected to the
# ACS resource. The name people see ("Zoxima Salesforce Team") is the display
# name set on that MailFrom address in Azure (Email Communication Service →
# Provision domains → <domain> → MailFrom addresses). Defaults to
# CONTACT_FROM_EMAIL.
GUIDE_FROM_EMAIL=

# Optional. Absolute URL of the guide PDF linked in the email. Defaults to
# https://www.zoxima.com/guides/zoxima-salesforce-guide.pdf, i.e. the file
# public/guides/zoxima-salesforce-guide.pdf in this project.
GUIDE_PDF_URL=

# Optional. Power Automate flow ("When an HTTP request is received") that adds
# each request as a row to the leads Excel sheet. Paste the flow's HTTP POST
# URL. It receives JSON: date, firstName, lastName, email, company, jobTitle,
# problem, fromPage, channel, consent. When unset, no row is added (the emails
# are still sent). Treat the URL as a secret: it contains a signature.
GUIDE_LEADS_WEBHOOK_URL=
